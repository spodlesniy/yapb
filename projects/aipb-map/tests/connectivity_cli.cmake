file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(MAP "${WORK}/fixture.aipbmap")
set(REPORT "${WORK}/preliminary-connectivity.json")
execute_process(COMMAND "${FIXTURE}" --write-fixture "${MAP}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Fixture failure: ${error}")
endif()
file(SHA256 "${MAP}/manifest.json" before)
execute_process(COMMAND "${CLI}" preliminary-connectivity --input "${MAP}" --output "${REPORT}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "Preliminary connectivity")
    message(FATAL_ERROR "Preliminary connectivity CLI failed: ${status}: ${output}: ${error}")
endif()
file(READ "${REPORT}" json)
string(JSON format GET "${json}" format)
string(JSON version GET "${json}" schema_version)
string(JSON count GET "${json}" edge_count)
string(JSON length LENGTH "${json}" edges)
if(NOT format STREQUAL "aipb-preliminary-connectivity" OR NOT version STREQUAL "0.8.0" OR
   NOT count EQUAL length)
    message(FATAL_ERROR "Invalid preliminary connectivity report")
endif()
execute_process(COMMAND "${CLI}" preliminary-connectivity --input "${MAP}" --output "${REPORT}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "Preliminary connectivity overwrote report")
endif()
execute_process(COMMAND "${CLI}" preliminary-connectivity --input "${MAP}" --output "${MAP}/inside.json"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0 OR EXISTS "${MAP}/inside.json")
    message(FATAL_ERROR "Preliminary connectivity wrote inside artifact")
endif()
file(SHA256 "${MAP}/manifest.json" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Map artifact modified")
endif()
file(REMOVE_RECURSE "${WORK}")
