file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(MAP "${WORK}/fixture.aipbmap")
set(VIS "${WORK}/fixture.nviz")
execute_process(COMMAND "${FIXTURE}" --write-fixture "${MAP}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Fixture creation failed: ${error}")
endif()
execute_process(COMMAND "${CLI}" export-navvis --input "${MAP}" --output "${VIS}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "Navigation viewer export")
    message(FATAL_ERROR "Navigation viewer export failed: ${status}: ${error}")
endif()
file(STRINGS "${VIS}" lines)
list(GET lines 0 header)
list(GET lines 1 counts)
list(GET lines -1 terminator)
if(NOT header MATCHES "^AIPBNAVVIS 1 connectivity_fixture [0-9a-f]+$" AND
   NOT header MATCHES "^AIPBNAVVIS 1 [A-Za-z0-9_]+ [0-9a-f]+$")
    message(FATAL_ERROR "Invalid viewer header: ${header}")
endif()
if(NOT counts MATCHES "^COUNT [0-9]+ [0-9]+$" OR NOT terminator STREQUAL "END")
    message(FATAL_ERROR "Invalid viewer counts or terminator")
endif()
string(REGEX REPLACE "^COUNT ([0-9]+) ([0-9]+)$" "\\1" nodes "${counts}")
string(REGEX REPLACE "^COUNT ([0-9]+) ([0-9]+)$" "\\2" edges "${counts}")
list(LENGTH lines length)
math(EXPR expected "${nodes}+${edges}+3")
if(NOT length EQUAL expected)
    message(FATAL_ERROR "Viewer record count mismatch")
endif()
execute_process(COMMAND "${CLI}" export-navvis --input "${MAP}" --output "${VIS}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "Viewer export overwrote an existing file")
endif()
file(REMOVE_RECURSE "${WORK}")
