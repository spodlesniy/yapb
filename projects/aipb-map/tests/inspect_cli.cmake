# Exercise the standalone CLI against a real, checksummed map artifact.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(MAP "${WORK}/fixture.aipbmap")
set(REPORT "${WORK}/inspection.json")
execute_process(COMMAND "${FIXTURE}" --write-fixture "${MAP}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Failed to write fixture: ${error}")
endif()
file(SHA256 "${MAP}/manifest.json" before)
execute_process(COMMAND "${CLI}" inspect --input "${MAP}" --output "${REPORT}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "Map: inspection_fixture")
    message(FATAL_ERROR "Inspection failed: ${status}: ${output}: ${error}")
endif()
file(READ "${REPORT}" json)
string(JSON schema GET "${json}" schema_version)
string(JSON triangles GET "${json}" triangle_count)
string(JSON hulls LENGTH "${json}" partition hulls)
string(JSON source GET "${json}" map_name)
if(NOT schema STREQUAL "0.1.0" OR NOT triangles EQUAL 2 OR NOT hulls EQUAL 8 OR
   NOT source STREQUAL "inspection_fixture")
    message(FATAL_ERROR "Unexpected inspection report JSON: ${json}")
endif()
execute_process(COMMAND "${CLI}" inspect --input "${MAP}" --output "${REPORT}"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
    message(FATAL_ERROR "CLI overwrote an existing report")
endif()
execute_process(COMMAND "${CLI}" inspect --input "${MAP}" --output "${MAP}/inside-report.json"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0 OR EXISTS "${MAP}/inside-report.json")
    message(FATAL_ERROR "CLI allowed a report inside the map artifact")
endif()
file(SHA256 "${MAP}/manifest.json" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "CLI modified input map artifact")
endif()
file(REMOVE_RECURSE "${WORK}")
