# D304: Standing jump followed by 250 ms of crouch.
# Manually place bot #1 on stable ground with Move bot before each run.
# Omitted XYZ/yaw/pitch use the live bot pose; initial velocity is explicitly zero.
[scenario]
version=aipb-scenario-v1
name=jump_crouch_01
map=de_dust2
timeout_ms=2500

[bot]
index=1
vx=0
vy=0
vz=0
crouching=0

[action]
duration_ms=60
forward=0
jump=1
duck=0

[action]
duration_ms=250
forward=0
jump=0
duck=1

[action]
duration_ms=1190
forward=0
jump=0
duck=0
