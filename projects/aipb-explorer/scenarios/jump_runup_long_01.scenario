# D304: Forward jump after a 500 ms approach.
# Manually place bot #1 on stable ground with Move bot before each run.
# Omitted XYZ/yaw/pitch use the live bot pose; initial velocity is explicitly zero.
[scenario]
version=aipb-scenario-v1
name=jump_runup_long_01
map=de_dust2
timeout_ms=3000

[bot]
index=1
vx=0
vy=0
vz=0
crouching=0

[action]
duration_ms=500
forward=1
jump=0
duck=0

[action]
duration_ms=60
forward=1
jump=1
duck=0

[action]
duration_ms=340
forward=1
jump=0
duck=0

[action]
duration_ms=900
forward=0
jump=0
duck=0
